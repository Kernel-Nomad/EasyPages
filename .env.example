# 1) Required
CF_API_TOKEN=xxxxx

# 2) Optional
# CF_ACCOUNT_ID=xxxxx
# EASYPAGES_DATA_DIR=/data   # Session secret and credentials. Docker sets this already.
# PORT=8002
# BIND_HOST=127.0.0.1        # Default. Docker image sets 0.0.0.0 so Compose can publish the port.
# SESSION_SECRET=            # Optional. Min 32 characters. If unset, created under EASYPAGES_DATA_DIR.
SESSION_COOKIE_SECURE=false
# TRUST_PROXY=false          # Compose default. Behind a reverse proxy set TRUST_PROXY=1
#                            # and SESSION_COOKIE_SECURE=true (Compose interpolates this file).
