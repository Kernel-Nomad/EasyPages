# pnpm uses a strict node_modules: a package only sees what it declares. That is what we
# want, because it surfaces the phantom dependencies npm's hoisting used to hide.

# Fail instead of silently installing when the lockfile and package.json disagree.
# CI already does this by default; this extends it to local environments.
prefer-frozen-lockfile=true

# Peer dependency warnings should not break the install.
strict-peer-dependencies=false
